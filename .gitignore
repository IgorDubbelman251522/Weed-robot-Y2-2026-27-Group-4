# Raw datasets are tracked via Git LFS (see .gitattributes); interim/processed stay local until decided
data/interim/*
data/processed/*
!data/raw/*.zip
!data/interim/.gitkeep
!data/processed/.gitkeep

# Trained weights
models/*
!models/.gitkeep

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.pytest_cache/
.venv/
venv/
.env

# Experiment tracking
mlruns/
wandb/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/